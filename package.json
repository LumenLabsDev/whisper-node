{
  "name": "@lumen-labs-dev/whisper-node",
  "version": "0.5.0",
  "description": "Local audio transcription on CPU. Node.js bindings for OpenAI's Whisper.",
  "homepage": "https://www.npmjs.com/package/@lumen-labs-dev/whisper-node",
  "author": "Maximiliano Veiga",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "whisper-node": "dist/cli/download.js",
    "download": "dist/cli/download.js"
  },
  "scripts": {
    "start": "npm run dev",
    "dev": "tsc --watch",
    "build": "node scripts/clean.js && tsc && node scripts/postbuild.js",
    "prepack": "npm run build && node scripts/prepack.js",
    "prepare": "npm run build",
    "test": "npm run build && node --test test/*.test.js",
    "native:setup": "node scripts/prepack.js",
    "benchmark": "npm run build && node --expose-gc scripts/benchmark.js"
  },
  "files": [
    "dist",
    "packages",
    "lib/whisper.cpp",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LumenLabsDev/whisper-node.git"
  },
  "license": "MIT",
  "keywords": [
    "OpenAI",
    "Whisper",
    "CPP",
    "C++",
    "Bindings",
    "Transcribe",
    "Transcriber",
    "Transcript",
    "Transcription",
    "Audio",
    "Speech",
    "Speech-to-Text",
    "STT",
    "TTS",
    "SRT",
    "Diarization",
    "Local"
  ],
  "directories": {
    "lib": "lib"
  },
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/LumenLabsDev/whisper-node/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
