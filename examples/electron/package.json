{
  "name": "whisper-node-electron-dictation",
  "version": "1.0.0",
  "private": true,
  "description": "Offline dictation with @lumen-labs-dev/whisper-node in Electron: microphone -> PCM 16 kHz -> IPC -> whisper-server",
  "main": "main.js",
  "scripts": {
    "prepare-resources": "node scripts/prepare-resources.js",
    "start": "electron .",
    "dist": "npm run prepare-resources && electron-builder --win nsis"
  },
  "dependencies": {
    "@lumen-labs-dev/whisper-node": "^1.1.0"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dev.example.whisper-dictation",
    "asar": true,
    "files": [
      "**/*",
      "!resources/**",
      "!node_modules/@lumen-labs-dev/whisper-node/lib/whisper.cpp/**",
      "!node_modules/ffmpeg-static/**"
    ],
    "extraResources": [
      { "from": "resources/bin/whisper", "to": "bin/whisper" },
      { "from": "resources/models", "to": "models", "filter": ["ggml-*.bin"] }
    ],
    "win": { "target": "nsis" }
  }
}
